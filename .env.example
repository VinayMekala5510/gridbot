# Copy to .env (never commit .env). The server reads it on start.
HOST=127.0.0.1
PORT=3000
TICK_MS=2000

# MySQL (leave DB_HOST empty to use in-memory storage for local testing)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gridbot
DB_USER=gridbot
DB_PASSWORD=

# 64 hex chars; encrypts saved exchange keys. Generate: openssl rand -hex 32
# Changing it makes previously saved accounts unreadable.
MASTER_KEY=
